{
  "name": "@akseer/ask-analyst-design-system",
  "version": "1.0.0",
  "description": "Ask Analyst design system — tokens, themed Mantine components, and the automated checks that keep them honest.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zia128111/ask-analyst-design-system.git"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "DESIGN-SYSTEM-v2.md",
    "CLAUDE.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "prepare": "npm run build:lib",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify:tokens": "node --experimental-strip-types scripts/verify-tokens.mjs",
    "verify:format": "node --experimental-strip-types scripts/verify-format.mjs",
    "verify": "npm run verify:tokens && npm run verify:format && npm run verify:charts && npm run verify:rtl && npm run verify:icons && npm run verify:email",
    "coverage": "node scripts/coverage.mjs",
    "verify:charts": "node --experimental-strip-types scripts/verify-charts.mjs",
    "verify:rtl": "node scripts/verify-rtl.mjs",
    "verify:icons": "node scripts/verify-icons.mjs",
    "verify:email": "node --experimental-strip-types scripts/verify-email.mjs",
    "verify:a11y": "npx --yes @axe-core/cli http://localhost:5173 --exit --tags wcag2a,wcag2aa,wcag21a,wcag21aa,wcag22aa",
    "audit:slots": "node scripts/audit-slots.mjs"
  },
  "peerDependencies": {
    "@mantine/core": "^9.6.0",
    "@mantine/dates": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@mantine/notifications": "^9.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "dayjs": "^1.11.23",
    "lato-font": "^3.0.0",
    "react-google-charts": "^5.2.1"
  },
  "devDependencies": {
    "@mantine/core": "^9.6.0",
    "@mantine/dates": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@mantine/notifications": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
